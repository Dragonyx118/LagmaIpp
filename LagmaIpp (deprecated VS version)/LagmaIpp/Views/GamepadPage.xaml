<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="LagmaIpp.Views.GamepadBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="BarBorder"
        BackgroundColor="#080B10"
        Stroke="#1E2A38"
        StrokeThickness="1"
        Padding="12,7"
        Margin="0,6,0,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
        </Border.StrokeShape>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

            <!-- Icona controller -->
            <Label
                Grid.Column="0"
                Text="🎮"
                FontSize="18"
                VerticalOptions="Center"/>

            <!-- Status text -->
            <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label
                    x:Name="LblStatus"
                    Text="Controller — non connesso"
                    TextColor="#3D5068"
                    FontSize="11"
                    FontAttributes="Bold"/>
                <Label
                    x:Name="LblHint"
                    Text=""
                    TextColor="#3D5068"
                    FontSize="10"/>
            </StackLayout>

            <!-- Servo selezionato (visibile solo in modalità ARM) -->
            <Border
                Grid.Column="2"
                x:Name="ServoIndicator"
                BackgroundColor="#0A1628"
                Stroke="#1E2A38"
                StrokeThickness="1"
                Padding="8,4"
                IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6"/>
                </Border.StrokeShape>
                <StackLayout Orientation="Horizontal" Spacing="5">
                    <Label Text="SERVO" TextColor="#3D5068" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="LblServo" Text="0" TextColor="#00D4FF" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Text="Y/X →" TextColor="#3D5068" FontSize="9" VerticalOptions="Center"/>
                </StackLayout>
            </Border>

            <!-- Bottone attiva/disattiva -->
            <Border
                Grid.Column="3"
                x:Name="BtnBorder"
                BackgroundColor="#0A1628"
                Stroke="#1E2A38"
                StrokeThickness="1"
                Padding="12,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnToggleTapped"/>
                </Border.GestureRecognizers>
                <Label
                    x:Name="LblBtn"
                    Text="ATTIVA"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#3D5068"
                    HorizontalOptions="Center"/>
            </Border>

        </Grid>
    </Border>

</ContentView>
